# Copy to .env.local for local work, and add the same keys in Vercel > Project > Settings > Environment Variables.

# Payment provider: "wompi" (default). With no keys set, checkout runs in DEMO mode and no money moves.
PAYMENT_PROVIDER=wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# Wompi Colombia only accepts COP. This is the USD to COP rate used to convert the deposit. Yessenia sets it.
USD_COP_RATE=4000
# Optional. The Wompi docs page does not state the checkout host, so confirm it in the sandbox.
# WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
